{
  "name": "balcona-bar",
  "version": "0.1.0",
  "private": true,
  "description": "Balcona Bar monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "pnpm --filter @balcona-bar/api start:dev",
    "api:build": "pnpm --filter @balcona-bar/api build",
    "api:start:prod": "pnpm --filter @balcona-bar/api start:prod",
    "api:test": "pnpm --filter @balcona-bar/api test",
    "api:prisma": "pnpm --filter @balcona-bar/api prisma",
    "api:prisma:generate": "pnpm --filter @balcona-bar/api prisma:generate",
    "api:prisma:migrate:dev": "pnpm --filter @balcona-bar/api prisma:migrate:dev",
    "api:prisma:migrate:deploy": "pnpm --filter @balcona-bar/api prisma:migrate:deploy",
    "api:prisma:seed": "pnpm --filter @balcona-bar/api prisma:seed",
    "deploy:api:migrate": "pnpm --filter @balcona-bar/api prisma:migrate:deploy",
    "deploy:api:seed": "pnpm --filter @balcona-bar/api prisma:seed",
    "deploy:api:bootstrap": "pnpm --filter @balcona-bar/api platform-admin:bootstrap",
    "deploy:api:smoke": "powershell -ExecutionPolicy Bypass -File scripts/deploy/staging-smoke.ps1",
    "deploy:staging:smoke:ps": "powershell -ExecutionPolicy Bypass -File scripts/deploy/staging-smoke.ps1",
    "deploy:staging:smoke:sh": "bash scripts/deploy/staging-smoke.sh",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t balcona-api:local .",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t balcona-web:local --build-arg NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1 .",
    "smoke:reset:staging": "node scripts/smoke/smoke-reset.mjs",
    "smoke:bootstrap:staging": "node scripts/smoke/smoke-bootstrap.mjs",
    "smoke:staging": "node scripts/smoke/staging-smoke.mjs --mode full",
    "smoke:staging:api": "node scripts/smoke/staging-smoke.mjs --mode full --api-only",
    "smoke:staging:web": "node scripts/smoke/staging-smoke.mjs --mode safe --web-only",
    "smoke:staging:full": "node scripts/smoke/staging-smoke.mjs --mode full",
    "smoke:staging:clean-full": "pnpm smoke:reset:staging && pnpm smoke:bootstrap:staging && pnpm smoke:staging:full",
    "smoke:test": "node --test scripts/smoke/*.test.mjs",
    "smoke:public:ps": "powershell -ExecutionPolicy Bypass -File scripts/deploy/smoke-test-public-demo.ps1",
    "web:dev": "pnpm --filter @balcona-bar/web dev",
    "web:build": "pnpm --filter @balcona-bar/web build",
    "web:lint": "pnpm --filter @balcona-bar/web lint",
    "web:start": "pnpm --filter @balcona-bar/web start",
    "web:typecheck": "pnpm --filter @balcona-bar/web typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1"
}
