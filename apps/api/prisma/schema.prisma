  tableSession            TableSession?            @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  venueZone               VenueZone?               @relation(fields: [venueZoneId], references: [id], onDelete: SetNull)
  customerSessionIdentity CustomerSessionIdentity? @relation(fields: [customerSessionIdentityId], references: [id], onDelete: SetNull)
  deviceSubscription      DeviceSubscription?      @relation(fields: [deviceSubscriptionId], references: [id], onDelete: SetNull)
  notifications           Notification[]

  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([triggerType])
  @@index([occurredAt])
  @@index([venueZoneId])
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  companyId String
  branchId  String?
  key       String
  kind      NotificationKind
  channel   NotificationChannel
  language  String              @default("ar-EG")
  title     String
  body      String
  isActive  Boolean             @default(true)
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([companyId, branchId, key, channel, language], map: "NotificationTemplate_scope_key")
  @@index([companyId])
  @@index([branchId])
  @@index([kind])
  @@index([channel])
  @@index([isActive])
}

model Notification {
  id                        String              @id @default(uuid())
  companyId                 String
  branchId                  String
  tableSessionId            String?
  customerSessionIdentityId String?
  orderId                   String?
  preparationTaskId         String?
  templateId                String?
  presenceEventId           String?
  kind                      NotificationKind
  channel                   NotificationChannel
  status                    NotificationStatus  @default(pending)
  title                     String
  body                      String
  dedupeKey                 String?
  metadata                  Json?
  sentAt                    DateTime?
  readAt                    DateTime?
  dismissedAt               DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                  Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession            TableSession?            @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  customerSessionIdentity CustomerSessionIdentity? @relation(fields: [customerSessionIdentityId], references: [id], onDelete: SetNull)
  order                   Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  preparationTask         PreparationTask?         @relation(fields: [preparationTaskId], references: [id], onDelete: SetNull)
  template                NotificationTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  presenceEvent           PresenceEvent?           @relation(fields: [presenceEventId], references: [id], onDelete: SetNull)
  deliveries              NotificationDelivery[]
  realtimeEvents          RealtimeEvent[]

  @@unique([dedupeKey])
  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([customerSessionIdentityId])
  @@index([kind])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([orderId])
  @@index([preparationTaskId])
}

model RealtimeEvent {
  id                String               @id @default(uuid())
  companyId         String
  branchId          String?
  tableSessionId    String?
  orderId           String?
  preparationTaskId String?
  waiterCallId      String?
  billRequestId     String?
  notificationId    String?
  type              RealtimeEventType
  channel           RealtimeEventChannel
  payload           Json
  createdAt         DateTime             @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tableSession    TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  preparationTask PreparationTask? @relation(fields: [preparationTaskId], references: [id], onDelete: SetNull)
  waiterCall      WaiterCall?      @relation(fields: [waiterCallId], references: [id], onDelete: SetNull)
  billRequest     BillRequest?     @relation(fields: [billRequestId], references: [id], onDelete: SetNull)
  notification    Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([orderId])
  @@index([preparationTaskId])
  @@index([waiterCallId])
  @@index([billRequestId])
  @@index([notificationId])
  @@index([type])
  @@index([channel])
  @@index([createdAt])
  @@index([branchId, channel, createdAt])
  @@index([tableSessionId, channel, createdAt])
}

model NotificationDelivery {
  id                   String                     @id @default(uuid())
  notificationId       String
  deviceSubscriptionId String?
  channel              NotificationChannel
  status               NotificationDeliveryStatus @default(pending)
  externalMessageId    String?
  errorMessage         String?
  sentAt               DateTime?
  failedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  notification       Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceSubscription DeviceSubscription? @relation(fields: [deviceSubscriptionId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([deviceSubscriptionId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model DemoRequest {
  id              String            @id @default(uuid())
  fullName        String
  businessName    String
  email           String
  phone           String?
  city            String?
  locationCount   Int               @default(1)
  message         String?
  consent         Boolean
  source          String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  status          DemoRequestStatus @default(new)
  internalNotes   String?
  lastContactedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([businessName])
}
