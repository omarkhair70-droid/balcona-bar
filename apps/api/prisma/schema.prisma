model Company {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  aiWaiterSessions          AiWaiterSession[]
  aiWaiterMessages          AiWaiterMessage[]
  aiWaiterCartProposals     AiWaiterCartProposal[]
  aiWaiterToolCalls         AiWaiterToolCall[]
  aiWaiterUsageEvents       AiWaiterUsageEvent[]
  auditLogs                 AuditLog[]
  branches                  Branch[]
  branchOperatingSettings   BranchOperatingSettings[]
  branchFeatureFlags        BranchFeatureFlag[]
  billRequests              BillRequest[]
  carts                     Cart[]
  menuCategories            MenuCategory[]
  menuItems                 MenuItem[]
  mediaAssets               MediaAsset[]
  mediaAssetUsages          MediaAssetUsage[]
  modifierGroups            ModifierGroup[]
  notificationTemplates     NotificationTemplate[]
  notifications             Notification[]
  experienceProfiles        ExperienceProfile[]
  contentBlocks             ContentBlock[]
  orders                    Order[]
  presenceEvents            PresenceEvent[]
  preparationTasks          PreparationTask[]
  realtimeEvents            RealtimeEvent[]
  smartCashierSettings      BranchSmartCashierSettings[]
  smartCashierReviewRules   SmartCashierReviewRule[]
  staffMemberships          StaffMembership[]
  staffSessions             StaffSession[]
  tableAttentionSnapshots   TableAttentionSnapshot[]
  tableAttentionEvents      TableAttentionEvent[]
  tableSessions             TableSession[]
  customerSessionIdentities CustomerSessionIdentity[]
  deviceSubscriptions       DeviceSubscription[]
  waiterCalls               WaiterCall[]
  venueZones                VenueZone[]
}

model Branch {
  id        String       @id @default(uuid())
  companyId String
  name      String
  slug      String
  address   String?
  status    BranchStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  aiWaiterSessions          AiWaiterSession[]
  aiWaiterMessages          AiWaiterMessage[]
  aiWaiterCartProposals     AiWaiterCartProposal[]
  aiWaiterToolCalls         AiWaiterToolCall[]
  aiWaiterUsageEvents       AiWaiterUsageEvent[]
  auditLogs                 AuditLog[]
  company                   Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operatingSettings         BranchOperatingSettings?
  featureFlags              BranchFeatureFlag[]
  billRequests              BillRequest[]
  carts                     Cart[]
  floors                    Floor[]
  mediaAssets               MediaAsset[]
  mediaAssetUsages          MediaAssetUsage[]
  menuItemOverrides         BranchMenuItemOverride[]
  notificationTemplates     NotificationTemplate[]
  notifications             Notification[]
  experienceProfiles        ExperienceProfile[]
  contentBlocks             ContentBlock[]
  orders                    Order[]
  presenceEvents            PresenceEvent[]
  preparationTasks          PreparationTask[]
  realtimeEvents            RealtimeEvent[]
  smartCashierSettings      BranchSmartCashierSettings?
  smartCashierReviewRules   SmartCashierReviewRule[]
  tableAttentionSnapshots   TableAttentionSnapshot[]
  tableAttentionEvents      TableAttentionEvent[]
  tables                    CafeTable[]
  staffMemberships          StaffMembership[]
  staffSessions             StaffSession[]
  tableSessions             TableSession[]
  customerSessionIdentities CustomerSessionIdentity[]
  deviceSubscriptions       DeviceSubscription[]
  waiterCalls               WaiterCall[]
  venueZones                VenueZone[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Floor {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables CafeTable[]

  @@index([branchId])
}

model CafeTable {
  id          String      @id @default(uuid())
  branchId    String
  floorId     String?
  code        String
  displayName String
  capacity    Int?
  qrToken     String      @unique
  status      TableStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor         Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  tableSessions TableSession[]
  waiterCalls   WaiterCall[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([floorId])
  @@index([qrToken])
}

model StaffUser {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String
  status        StaffStatus @default(active)
  passwordHash  String?
  passwordSetAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  memberships              StaffMembership[]
  sessions                 StaffSession[]
  servedOrders             Order[]                @relation("OrderServedByStaff")
  completedOrders          Order[]                @relation("OrderCompletedByStaff")
  orderEvents              OrderEvent[]
  acknowledgedBillRequests BillRequest[]          @relation("BillRequestAcknowledgedByStaff")
  presentedBillRequests    BillRequest[]          @relation("BillRequestPresentedByStaff")
  closedBillRequests       BillRequest[]          @relation("BillRequestClosedByStaff")
  cancelledBillRequests    BillRequest[]          @relation("BillRequestCancelledByStaff")
  billRequestEvents        BillRequestEvent[]
  preparationTaskEvents    PreparationTaskEvent[]
  waiterCallEvents         WaiterCallEvent[]
  auditLogs                AuditLog[]

  @@index([email])
}

model StaffMembership {
  id          String      @id @default(uuid())
  staffUserId String
  companyId   String
  branchId    String?
  role        StaffRole
  status      StaffStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, companyId, branchId, role])
  @@index([staffUserId])
  @@index([companyId])
  @@index([branchId])
  @@index([companyId, branchId, role])
}

model StaffSession {
  id               String             @id @default(uuid())
  companyId        String
  branchId         String?
  staffUserId      String
  status           StaffSessionStatus @default(active)
  tokenHash        String             @unique
  refreshTokenHash String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([branchId])
  @@index([staffUserId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model MenuCategory {
  id          String             @id @default(uuid())
  companyId   String
  name        String
  slug        String
  description String?
  sortOrder   Int                @default(0)
  status      MenuCategoryStatus @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                   MenuItem[]
  smartCashierReviewRules SmartCashierReviewRule[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
}

model MenuItem {
  id             String             @id @default(uuid())
  companyId      String
  categoryId     String
  name           String
  slug           String
  description    String?
  imageUrl       String?
  basePriceMinor Int
  currency       String             @default("EGP")
  station        PreparationStation
  status         MenuItemStatus     @default(active)
  isFeatured     Boolean            @default(false)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category                MenuCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifierGroups          MenuItemModifierGroup[]
  branchOverrides         BranchMenuItemOverride[]
  cartItems               CartItem[]
  orderItems              OrderItem[]
  smartCashierReviewRules SmartCashierReviewRule[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([station])
}

model ModifierGroup {
  id            String                @id @default(uuid())
  companyId     String
  name          String
  slug          String
  description   String?
  selectionType ModifierSelectionType
  isRequired    Boolean               @default(false)
  minSelections Int                   @default(0)
  maxSelections Int                   @default(1)
  sortOrder     Int                   @default(0)
  status        ModifierGroupStatus   @default(active)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  options                  ModifierOption[]
  menuItems                MenuItemModifierGroup[]
  cartItemModifierOptions  CartItemModifierOption[]
  orderItemModifierOptions OrderItemModifierOption[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
}

model ModifierOption {
  id              String               @id @default(uuid())
  groupId         String
  name            String
  slug            String
  priceDeltaMinor Int                  @default(0)
  status          ModifierOptionStatus @default(active)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  group                    ModifierGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cartItemModifierOptions  CartItemModifierOption[]
  orderItemModifierOptions OrderItemModifierOption[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([status])
}

model MenuItemModifierGroup {
  id              String   @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@index([modifierGroupId])
}

model BranchMenuItemOverride {
  id                 String   @id @default(uuid())
  branchId           String
  menuItemId         String
  priceOverrideMinor Int?
  isAvailable        Boolean  @default(true)
  isVisible          Boolean  @default(true)
  sortOrder          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, menuItemId])
  @@index([branchId])
  @@index([menuItemId])
  @@index([isAvailable])
  @@index([isVisible])
}

model BranchSmartCashierSettings {
  id                             String           @id @default(uuid())
  companyId                      String
  branchId                       String           @unique
  mode                           SmartCashierMode @default(manual_only)
  enabled                        Boolean          @default(false)
  maxAutoAcceptSubtotalMinor     Int?
  requirePaymentBeforeAutoAccept Boolean          @default(false)
  reviewCustomerNotes            Boolean          @default(true)
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([branchId])
  @@index([mode])
  @@index([enabled])
}

model BranchOperatingSettings {
  id                      String              @id @default(uuid())
  companyId               String
  branchId                String              @unique
  operatingMode           BranchOperatingMode @default(assisted)
  serviceMode             BranchServiceMode   @default(dine_in)
  aiWaiterEnabled         Boolean             @default(true)
  waiterCallsEnabled      Boolean             @default(true)
  smartCashierEnabled     Boolean             @default(true)
  realtimeEnabled         Boolean             @default(true)
  mediaExperienceEnabled  Boolean             @default(true)
  billFlowEnabled         Boolean             @default(true)
  tableAttentionEnabled   Boolean             @default(true)
  analyticsEnabled        Boolean             @default(true)
  notificationsEnabled    Boolean             @default(true)
  presenceTriggersEnabled Boolean             @default(true)
  openingHours            Json?
  serviceConfig           Json?
  attentionConfig         Json?
  metadata                Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([branchId])
  @@index([operatingMode])
  @@index([serviceMode])
}

model BranchFeatureFlag {
  id        String               @id @default(uuid())
  companyId String
  branchId  String
  key       BranchFeatureFlagKey
  enabled   Boolean              @default(true)
  config    Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@index([companyId])
  @@index([branchId])
  @@index([key])
  @@index([enabled])
}

model SmartCashierReviewRule {
  id         String                 @id @default(uuid())
  companyId  String
  branchId   String
  scope      SmartCashierRuleScope
  menuItemId String?
  categoryId String?
  reasonCode ManualReviewReasonCode
  enabled    Boolean                @default(true)
  note       String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  category MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([branchId])
  @@index([scope])
  @@index([menuItemId])
  @@index([categoryId])
  @@index([reasonCode])
  @@index([enabled])
}

model TableSession {
  id          String             @id @default(uuid())
  companyId   String
  branchId    String
  tableId     String
  status      TableSessionStatus @default(active)
  source      TableSessionSource
  guestLabel  String?
  partySize   Int?
  startedAt   DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  expiresAt   DateTime?
  closedAt    DateTime?
  closeReason String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  aiWaiterSessions          AiWaiterSession[]
  aiWaiterMessages          AiWaiterMessage[]
  aiWaiterCartProposals     AiWaiterCartProposal[]
  aiWaiterToolCalls         AiWaiterToolCall[]
  aiWaiterUsageEvents       AiWaiterUsageEvent[]
  auditLogs                 AuditLog[]
  company                   Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                    Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  billRequests              BillRequest[]
  table                     CafeTable                 @relation(fields: [tableId], references: [id], onDelete: Cascade)
  carts                     Cart[]
  events                    TableSessionEvent[]
  notifications             Notification[]
  orders                    Order[]
  presenceEvents            PresenceEvent[]
  realtimeEvents            RealtimeEvent[]
  tableAttentionSnapshot    TableAttentionSnapshot?
  tableAttentionEvents      TableAttentionEvent[]
  customerSessionIdentities CustomerSessionIdentity[]
  deviceSubscriptions       DeviceSubscription[]
  waiterCalls               WaiterCall[]

  @@index([companyId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
