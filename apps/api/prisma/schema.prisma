model Company {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  aiWaiterSessions              AiWaiterSession[]
  aiWaiterMessages              AiWaiterMessage[]
  aiWaiterCartProposals         AiWaiterCartProposal[]
  aiWaiterToolCalls             AiWaiterToolCall[]
  aiWaiterUsageEvents           AiWaiterUsageEvent[]
  auditLogs                     AuditLog[]
  branches                      Branch[]
  branchOperatingSettings       BranchOperatingSettings[]
  branchFeatureFlags            BranchFeatureFlag[]
  bills                         Bill[]
  billRequests                  BillRequest[]
  carts                         Cart[]
  menuCategories                MenuCategory[]
  menuItems                     MenuItem[]
  mediaAssets                   MediaAsset[]
  mediaAssetUsages              MediaAssetUsage[]
  modifierGroups                ModifierGroup[]
  notificationTemplates         NotificationTemplate[]
  notifications                 Notification[]
  experienceProfiles            ExperienceProfile[]
  contentBlocks                 ContentBlock[]
  inventoryItems                InventoryItem[]
  inventoryLevels               BranchInventoryLevel[]
  inventoryMovements            InventoryMovement[]
  suppliers                     Supplier[]
  purchaseOrders                PurchaseOrder[]
  inventoryReceipts             InventoryReceipt[]
  menuItemInventoryRequirements MenuItemInventoryRequirement[]
  orders                        Order[]
  presenceEvents                PresenceEvent[]
  preparationTasks              PreparationTask[]
  kitchenTickets                KitchenTicket[]
  manualPayments                ManualPayment[]
  onlinePaymentIntents          OnlinePaymentIntent[]
  onlinePaymentEvents           OnlinePaymentEvent[]
  onlinePaymentOperations       OnlinePaymentOperation[]
  onlinePaymentReconciliationRuns OnlinePaymentReconciliationRun[]
  onlinePaymentReconciliationEntries OnlinePaymentReconciliationEntry[]
  onlinePaymentReconciliationIssues OnlinePaymentReconciliationIssue[]
  onlinePaymentSettlementBatches OnlinePaymentSettlementBatch[]
  cashierShifts                 CashierShift[]
  cashDrawerTransactions        CashDrawerTransaction[]
  cashierShiftReports           CashierShiftReport[]
  printerStations               PrinterStation[]
  printJobs                     PrintJob[]
  billReceipts                  BillReceipt[]
  realtimeEvents                RealtimeEvent[]
  smartCashierSettings          BranchSmartCashierSettings[]
  smartCashierReviewRules       SmartCashierReviewRule[]
  staffMemberships              StaffMembership[]
  staffInvites                  StaffInvite[]
  staffSessions                 StaffSession[]
  tableAttentionSnapshots       TableAttentionSnapshot[]
  tableAttentionEvents          TableAttentionEvent[]
  tableSessions                 TableSession[]
  customerSessionIdentities     CustomerSessionIdentity[]
  deviceSubscriptions           DeviceSubscription[]
  saasSubscription              CompanySubscription?
  saasLimitOverrides            CompanyPlanLimitOverride[]
  waiterCalls                   WaiterCall[]
  venueZones                    VenueZone[]
}

model SaasPlan {
  id                     String         @id @default(uuid())
  code                   String         @unique
  name                   String
  status                 SaasPlanStatus @default(active)
  description            String?
  monthlyPriceMinor      Int?
  currency               String         @default("EGP")
  maxBranches            Int?
  maxTables              Int?
  maxStaffUsers          Int?
  maxMenuItems           Int?
  maxInventoryItems      Int?
  maxAiMessagesPerMonth  Int?
  setupEnabled           Boolean        @default(true)
  kdsEnabled             Boolean        @default(true)
  inventoryEnabled       Boolean        @default(true)
  onlinePaymentsEnabled  Boolean        @default(false)
  ownerAnalyticsEnabled  Boolean        @default(true)
  aiWaiterEnabled        Boolean        @default(true)
  multiBranchEnabled     Boolean        @default(false)
  advancedReportsEnabled Boolean        @default(false)
  sortOrder              Int            @default(0)
  metadata               Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  subscriptions CompanySubscription[]

  @@index([status])
  @@index([sortOrder])
}

model CompanySubscription {
  id                 String                    @id @default(uuid())
  companyId          String                    @unique
  planId             String
  status             CompanySubscriptionStatus @default(trialing)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  suspendedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  metadata           Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SaasPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
}

model CompanyPlanLimitOverride {
  id           String   @id @default(uuid())
  companyId    String
  key          String
  valueInt     Int?
  valueBoolean Boolean?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@index([key])
}

