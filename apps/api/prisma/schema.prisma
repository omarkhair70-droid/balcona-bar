generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  active
  inactive
}

enum BranchStatus {
  active
  inactive
}

enum TableStatus {
  active
  inactive
  maintenance
}

enum StaffStatus {
  active
  inactive
}

enum StaffRole {
  owner
  branch_manager
  cashier
  waiter
  kitchen
  barista
  menu_admin
}

enum MenuCategoryStatus {
  active
  inactive
}

enum MenuItemStatus {
  active
  inactive
  archived
}

enum ModifierGroupStatus {
  active
  inactive
}

enum ModifierOptionStatus {
  active
  inactive
}

enum ModifierSelectionType {
  single
  multiple
}

enum PreparationStation {
  barista
  kitchen
  dessert
  cashier
}

enum TableSessionStatus {
  active
  idle
  closed
  expired
}

enum TableSessionSource {
  qr
  staff
  dev
}

enum TableSessionEventType {
  created
  resumed
  viewed
  closed
  expired
}

enum CartStatus {
  draft
  cleared
  converted
}

enum OrderStatus {
  submitted
  cashier_accepted
  cashier_rejected
  cancelled
}

enum OrderSource {
  customer_qr
  staff
  dev
}

enum OrderEventType {
  submitted
  cashier_accepted
  cashier_rejected
  cancelled
}

enum OrderEventActorType {
  customer
  staff
  system
  dev
}

model Company {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  branches         Branch[]
  carts            Cart[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  modifierGroups   ModifierGroup[]
  orders           Order[]
  staffMemberships StaffMembership[]
  tableSessions    TableSession[]
}

model Branch {
  id        String       @id @default(uuid())
  companyId String
  name      String
  slug      String
  address   String?
  status    BranchStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  carts             Cart[]
  floors            Floor[]
  menuItemOverrides BranchMenuItemOverride[]
  orders            Order[]
  tables            CafeTable[]
  staffMemberships  StaffMembership[]
  tableSessions     TableSession[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Floor {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables CafeTable[]

  @@index([branchId])
}

model CafeTable {
  id          String      @id @default(uuid())
  branchId    String
  floorId     String?
  code        String
  displayName String
  capacity    Int?
  qrToken     String      @unique
  status      TableStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor         Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  tableSessions TableSession[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([floorId])
  @@index([qrToken])
}

model StaffUser {
  id        String      @id @default(uuid())
  email     String      @unique
  name      String
  status    StaffStatus @default(active)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  memberships StaffMembership[]
  orderEvents OrderEvent[]

  @@index([email])
}

model StaffMembership {
  id          String      @id @default(uuid())
  staffUserId String
  companyId   String
  branchId    String?
  role        StaffRole
  status      StaffStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, companyId, branchId, role])
  @@index([staffUserId])
  @@index([companyId])
  @@index([branchId])
  @@index([companyId, branchId, role])
}

model MenuCategory {
  id          String             @id @default(uuid())
  companyId   String
  name        String
  slug        String
  description String?
  sortOrder   Int                @default(0)
  status      MenuCategoryStatus @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   MenuItem[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
}

model MenuItem {
  id             String             @id @default(uuid())
  companyId      String
  categoryId     String
  name           String
  slug           String
  description    String?
  imageUrl       String?
  basePriceMinor Int
  currency       String             @default("EGP")
  station        PreparationStation
  status         MenuItemStatus     @default(active)
  isFeatured     Boolean            @default(false)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        MenuCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifierGroups  MenuItemModifierGroup[]
  branchOverrides BranchMenuItemOverride[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([station])
}

model ModifierGroup {
  id            String              @id @default(uuid())
  companyId     String
  name          String
  slug          String
  description   String?
  selectionType ModifierSelectionType
  isRequired    Boolean             @default(false)
  minSelections Int                 @default(0)
  maxSelections Int                 @default(1)
  sortOrder     Int                 @default(0)
  status        ModifierGroupStatus @default(active)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  options                  ModifierOption[]
  menuItems                MenuItemModifierGroup[]
  cartItemModifierOptions  CartItemModifierOption[]
  orderItemModifierOptions OrderItemModifierOption[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
}

model ModifierOption {
  id              String               @id @default(uuid())
  groupId         String
  name            String
  slug            String
  priceDeltaMinor Int                  @default(0)
  status          ModifierOptionStatus @default(active)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  group                    ModifierGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cartItemModifierOptions  CartItemModifierOption[]
  orderItemModifierOptions OrderItemModifierOption[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([status])
}

model MenuItemModifierGroup {
  id              String   @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@index([modifierGroupId])
}

model BranchMenuItemOverride {
  id                 String   @id @default(uuid())
  branchId           String
  menuItemId         String
  priceOverrideMinor Int?
  isAvailable        Boolean  @default(true)
  isVisible          Boolean  @default(true)
  sortOrder          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, menuItemId])
  @@index([branchId])
  @@index([menuItemId])
  @@index([isAvailable])
  @@index([isVisible])
}

model TableSession {
  id          String             @id @default(uuid())
  companyId   String
  branchId    String
  tableId     String
  status      TableSessionStatus @default(active)
  source      TableSessionSource
  guestLabel  String?
  partySize   Int?
  startedAt   DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  expiresAt   DateTime?
  closedAt    DateTime?
  closeReason String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table   CafeTable           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  carts   Cart[]
  events  TableSessionEvent[]
  orders  Order[]

  @@index([companyId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([lastSeenAt])
}

model TableSessionEvent {
  id             String                @id @default(uuid())
  tableSessionId String
  type           TableSessionEventType
  metadata       Json?
  createdAt      DateTime              @default(now())

  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  @@index([tableSessionId])
}

model Cart {
  id             String     @id @default(uuid())
  tableSessionId String
  companyId      String
  branchId       String
  status         CartStatus @default(draft)
  currency       String     @default("EGP")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items        CartItem[]
  orders       Order[]

  @@index([tableSessionId])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
}

model CartItem {
  id                              String   @id @default(uuid())
  cartId                          String
  menuItemId                      String
  quantity                        Int
  notes                           String?
  itemNameSnapshot                String
  itemSlugSnapshot                String
  basePriceMinorSnapshot          Int
  effectiveBasePriceMinorSnapshot Int
  modifiersTotalMinorSnapshot     Int
  unitPriceMinorSnapshot          Int
  lineTotalMinorSnapshot          Int
  currency                        String
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  cart            Cart                     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem        MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  modifierOptions CartItemModifierOption[]

  @@index([cartId])
  @@index([menuItemId])
}

model CartItemModifierOption {
  id                         String   @id @default(uuid())
  cartItemId                 String
  modifierGroupId            String
  modifierOptionId           String
  modifierGroupNameSnapshot  String
  modifierGroupSlugSnapshot  String
  modifierOptionNameSnapshot String
  modifierOptionSlugSnapshot String
  priceDeltaMinorSnapshot    Int
  createdAt                  DateTime @default(now())

  cartItem       CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierGroup  ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([cartItemId])
  @@index([modifierGroupId])
  @@index([modifierOptionId])
}

model Order {
  id                 String       @id @default(uuid())
  companyId          String
  branchId           String
  tableSessionId     String
  cartId             String?
  orderNumber        String
  status             OrderStatus  @default(submitted)
  source             OrderSource
  currency           String       @default("EGP")
  subtotalMinor      Int
  totalQuantity      Int
  itemCount          Int
  customerNote       String?
  idempotencyKey     String?
  submittedAt        DateTime     @default(now())
  cashierAcceptedAt  DateTime?
  cashierRejectedAt  DateTime?
  rejectionReason    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession TableSession  @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  cart         Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]

  @@unique([branchId, orderNumber])
  @@unique([tableSessionId, idempotencyKey])
  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([status])
  @@index([submittedAt])
}

model OrderItem {
  id                              String   @id @default(uuid())
  orderId                         String
  menuItemId                      String
  quantity                        Int
  notes                           String?
  itemNameSnapshot                String
  itemSlugSnapshot                String
  basePriceMinorSnapshot          Int
  effectiveBasePriceMinorSnapshot Int
  modifiersTotalMinorSnapshot     Int
  unitPriceMinorSnapshot          Int
  lineTotalMinorSnapshot          Int
  currency                        String
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem                  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  modifierOptions OrderItemModifierOption[]

  @@index([orderId])
  @@index([menuItemId])
}

model OrderItemModifierOption {
  id                         String   @id @default(uuid())
  orderItemId                String
  modifierGroupId            String
  modifierOptionId           String
  modifierGroupNameSnapshot  String
  modifierGroupSlugSnapshot  String
  modifierOptionNameSnapshot String
  modifierOptionSlugSnapshot String
  priceDeltaMinorSnapshot    Int
  createdAt                  DateTime @default(now())

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierGroup  ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierGroupId])
  @@index([modifierOptionId])
}

model OrderEvent {
  id               String              @id @default(uuid())
  orderId          String
  type             OrderEventType
  actorType        OrderEventActorType
  actorStaffUserId String?
  metadata         Json?
  createdAt        DateTime            @default(now())

  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorStaffUser StaffUser? @relation(fields: [actorStaffUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}
