generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  active
  inactive
}

enum BranchStatus {
  active
  inactive
}

enum TableStatus {
  active
  inactive
  maintenance
}

enum StaffStatus {
  active
  inactive
}

enum StaffRole {
  owner
  branch_manager
  cashier
  waiter
  kitchen
  barista
  menu_admin
}

enum MenuCategoryStatus {
  active
  inactive
}

enum MenuItemStatus {
  active
  inactive
  archived
}

enum ModifierGroupStatus {
  active
  inactive
}

enum ModifierOptionStatus {
  active
  inactive
}

enum ModifierSelectionType {
  single
  multiple
}

enum PreparationStation {
  barista
  kitchen
  dessert
  cashier
}

enum PreparationTaskStatus {
  pending
  preparing
  ready
  cancelled
}

enum PreparationTaskEventType {
  created
  started
  marked_ready
  cancelled
}

enum TableSessionStatus {
  active
  idle
  closed
  expired
}

enum TableSessionSource {
  qr
  staff
  dev
}

enum TableSessionEventType {
  created
  resumed
  viewed
  closed
  expired
}

enum CartStatus {
  draft
  cleared
  converted
}

enum OrderStatus {
  submitted
  cashier_accepted
  cashier_rejected
  cancelled
}

enum OrderSource {
  customer_qr
  staff
  dev
}

enum OrderEventType {
  submitted
  cashier_accepted
  cashier_rejected
  cancelled
}

enum OrderEventActorType {
  customer
  staff
  system
  dev
}

enum WaiterCallType {
  call_waiter
  need_bill
  need_water
  need_help
  order_problem
  clean_table
  other
}

enum WaiterCallStatus {
  open
  acknowledged
  resolved
  cancelled
}

enum WaiterCallEventType {
  created
  acknowledged
  resolved
  cancelled
}

enum WaiterCallActorType {
  customer
  staff
  system
  dev
}

enum PresenceTriggerType {
  qr_session_started
  qr_session_resumed
  wifi_portal_entered
  beacon_detected
  geofence_entered
  app_opened_near_venue
  manual_staff_trigger
}

enum NotificationChannel {
  in_app
  web_push
  whatsapp
  sms
  wifi_portal
  beacon
  geofence
}

enum NotificationKind {
  welcome
  order_submitted
  order_accepted
  order_rejected
  preparation_started
  preparation_ready
  waiter_call
  system
}

enum NotificationStatus {
  pending
  sent
  failed
  read
  dismissed
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
}

enum DeviceSubscriptionStatus {
  active
  revoked
  expired
}

enum VenueZoneType {
  branch
  entrance
  seating_area
  cashier
  kitchen
  outdoor
  custom
}

model Company {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  branches                  Branch[]
  carts                     Cart[]
  menuCategories            MenuCategory[]
  menuItems                 MenuItem[]
  modifierGroups            ModifierGroup[]
  notificationTemplates     NotificationTemplate[]
  notifications             Notification[]
  orders                    Order[]
  presenceEvents            PresenceEvent[]
  preparationTasks          PreparationTask[]
  staffMemberships          StaffMembership[]
  tableSessions             TableSession[]
  customerSessionIdentities CustomerSessionIdentity[]
  deviceSubscriptions       DeviceSubscription[]
  waiterCalls               WaiterCall[]
  venueZones                VenueZone[]
}

model Branch {
  id        String       @id @default(uuid())
  companyId String
  name      String
  slug      String
  address   String?
  status    BranchStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company                   Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  carts                     Cart[]
  floors                    Floor[]
  menuItemOverrides         BranchMenuItemOverride[]
  notificationTemplates     NotificationTemplate[]
  notifications             Notification[]
  orders                    Order[]
  presenceEvents            PresenceEvent[]
  preparationTasks          PreparationTask[]
  tables                    CafeTable[]
  staffMemberships          StaffMembership[]
  tableSessions             TableSession[]
  customerSessionIdentities CustomerSessionIdentity[]
  deviceSubscriptions       DeviceSubscription[]
  waiterCalls               WaiterCall[]
  venueZones                VenueZone[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Floor {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables CafeTable[]

  @@index([branchId])
}

model CafeTable {
  id          String      @id @default(uuid())
  branchId    String
  floorId     String?
  code        String
  displayName String
  capacity    Int?
  qrToken     String      @unique
  status      TableStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor         Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  tableSessions TableSession[]
  waiterCalls   WaiterCall[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([floorId])
  @@index([qrToken])
}

model StaffUser {
  id        String      @id @default(uuid())
  email     String      @unique
  name      String
  status    StaffStatus @default(active)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  memberships           StaffMembership[]
  orderEvents           OrderEvent[]
  preparationTaskEvents PreparationTaskEvent[]
  waiterCallEvents      WaiterCallEvent[]

  @@index([email])
}

model StaffMembership {
  id          String      @id @default(uuid())
  staffUserId String
  companyId   String
  branchId    String?
  role        StaffRole
  status      StaffStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, companyId, branchId, role])
  @@index([staffUserId])
  @@index([companyId])
  @@index([branchId])
  @@index([companyId, branchId, role])
}

model MenuCategory {
  id          String             @id @default(uuid())
  companyId   String
  name        String
  slug        String
  description String?
  sortOrder   Int                @default(0)
  status      MenuCategoryStatus @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   MenuItem[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
}

model MenuItem {
  id             String             @id @default(uuid())
  companyId      String
  categoryId     String
  name           String
  slug           String
  description    String?
  imageUrl       String?
  basePriceMinor Int
  currency       String             @default("EGP")
  station        PreparationStation
  status         MenuItemStatus     @default(active)
  isFeatured     Boolean            @default(false)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        MenuCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifierGroups  MenuItemModifierGroup[]
  branchOverrides BranchMenuItemOverride[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([station])
}

model ModifierGroup {
  id            String                @id @default(uuid())
  companyId     String
  name          String
  slug          String
  description   String?
  selectionType ModifierSelectionType
  isRequired    Boolean               @default(false)
  minSelections Int                   @default(0)
  maxSelections Int                   @default(1)
  sortOrder     Int                   @default(0)
  status        ModifierGroupStatus   @default(active)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  options                  ModifierOption[]
  menuItems                MenuItemModifierGroup[]
  cartItemModifierOptions  CartItemModifierOption[]
  orderItemModifierOptions OrderItemModifierOption[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
}

model ModifierOption {
  id              String               @id @default(uuid())
  groupId         String
  name            String
  slug            String
  priceDeltaMinor Int                  @default(0)
  status          ModifierOptionStatus @default(active)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  group                    ModifierGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cartItemModifierOptions  CartItemModifierOption[]
  orderItemModifierOptions OrderItemModifierOption[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([status])
}

model MenuItemModifierGroup {
  id              String   @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@index([modifierGroupId])
}

model BranchMenuItemOverride {
  id                 String   @id @default(uuid())
  branchId           String
  menuItemId         String
  priceOverrideMinor Int?
  isAvailable        Boolean  @default(true)
  isVisible          Boolean  @default(true)
  sortOrder          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, menuItemId])
  @@index([branchId])
  @@index([menuItemId])
  @@index([isAvailable])
  @@index([isVisible])
}

model TableSession {
  id          String             @id @default(uuid())
  companyId   String
  branchId    String
  tableId     String
  status      TableSessionStatus @default(active)
  source      TableSessionSource
  guestLabel  String?
  partySize   Int?
  startedAt   DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  expiresAt   DateTime?
  closedAt    DateTime?
  closeReason String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company                   Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                    Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table                     CafeTable                 @relation(fields: [tableId], references: [id], onDelete: Cascade)
  carts                     Cart[]
  events                    TableSessionEvent[]
  notifications             Notification[]
  orders                    Order[]
  presenceEvents            PresenceEvent[]
  customerSessionIdentities CustomerSessionIdentity[]
  deviceSubscriptions       DeviceSubscription[]
  waiterCalls               WaiterCall[]

  @@index([companyId])
  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([lastSeenAt])
}

model TableSessionEvent {
  id             String                @id @default(uuid())
  tableSessionId String
  type           TableSessionEventType
  metadata       Json?
  createdAt      DateTime              @default(now())

  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  @@index([tableSessionId])
}

model Cart {
  id             String     @id @default(uuid())
  tableSessionId String
  companyId      String
  branchId       String
  status         CartStatus @default(draft)
  currency       String     @default("EGP")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items        CartItem[]
  orders       Order[]

  @@index([tableSessionId])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
}

model CartItem {
  id                              String   @id @default(uuid())
  cartId                          String
  menuItemId                      String
  quantity                        Int
  notes                           String?
  itemNameSnapshot                String
  itemSlugSnapshot                String
  basePriceMinorSnapshot          Int
  effectiveBasePriceMinorSnapshot Int
  modifiersTotalMinorSnapshot     Int
  unitPriceMinorSnapshot          Int
  lineTotalMinorSnapshot          Int
  currency                        String
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  cart            Cart                     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem        MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  modifierOptions CartItemModifierOption[]

  @@index([cartId])
  @@index([menuItemId])
}

model CartItemModifierOption {
  id                         String   @id @default(uuid())
  cartItemId                 String
  modifierGroupId            String
  modifierOptionId           String
  modifierGroupNameSnapshot  String
  modifierGroupSlugSnapshot  String
  modifierOptionNameSnapshot String
  modifierOptionSlugSnapshot String
  priceDeltaMinorSnapshot    Int
  createdAt                  DateTime @default(now())

  cartItem       CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierGroup  ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([cartItemId])
  @@index([modifierGroupId])
  @@index([modifierOptionId])
}

model Order {
  id                String      @id @default(uuid())
  companyId         String
  branchId          String
  tableSessionId    String
  cartId            String?
  orderNumber       String
  status            OrderStatus @default(submitted)
  source            OrderSource
  currency          String      @default("EGP")
  subtotalMinor     Int
  totalQuantity     Int
  itemCount         Int
  customerNote      String?
  idempotencyKey    String?
  submittedAt       DateTime    @default(now())
  cashierAcceptedAt DateTime?
  cashierRejectedAt DateTime?
  rejectionReason   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession     TableSession      @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  cart             Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  events           OrderEvent[]
  notifications    Notification[]
  preparationTasks PreparationTask[]
  waiterCalls      WaiterCall[]

  @@unique([branchId, orderNumber])
  @@unique([tableSessionId, idempotencyKey])
  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([status])
  @@index([submittedAt])
}

model OrderItem {
  id                              String   @id @default(uuid())
  orderId                         String
  menuItemId                      String
  quantity                        Int
  notes                           String?
  itemNameSnapshot                String
  itemSlugSnapshot                String
  basePriceMinorSnapshot          Int
  effectiveBasePriceMinorSnapshot Int
  modifiersTotalMinorSnapshot     Int
  unitPriceMinorSnapshot          Int
  lineTotalMinorSnapshot          Int
  currency                        String
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem                  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  modifierOptions OrderItemModifierOption[]
  preparationTask PreparationTask?

  @@index([orderId])
  @@index([menuItemId])
}

model OrderItemModifierOption {
  id                         String   @id @default(uuid())
  orderItemId                String
  modifierGroupId            String
  modifierOptionId           String
  modifierGroupNameSnapshot  String
  modifierGroupSlugSnapshot  String
  modifierOptionNameSnapshot String
  modifierOptionSlugSnapshot String
  priceDeltaMinorSnapshot    Int
  createdAt                  DateTime @default(now())

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierGroup  ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierGroupId])
  @@index([modifierOptionId])
}

model OrderEvent {
  id               String              @id @default(uuid())
  orderId          String
  type             OrderEventType
  actorType        OrderEventActorType
  actorStaffUserId String?
  metadata         Json?
  createdAt        DateTime            @default(now())

  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorStaffUser StaffUser? @relation(fields: [actorStaffUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model PreparationTask {
  id               String                @id @default(uuid())
  companyId        String
  branchId         String
  orderId          String
  orderItemId      String
  station          PreparationStation
  status           PreparationTaskStatus @default(pending)
  quantity         Int
  itemNameSnapshot String
  itemSlugSnapshot String
  notes            String?
  startedAt        DateTime?
  readyAt          DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem     OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  events        PreparationTaskEvent[]
  notifications Notification[]

  @@unique([orderItemId])
  @@index([companyId])
  @@index([branchId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([station])
  @@index([status])
  @@index([createdAt])
}

model PreparationTaskEvent {
  id                String                   @id @default(uuid())
  preparationTaskId String
  type              PreparationTaskEventType
  actorStaffUserId  String?
  metadata          Json?
  createdAt         DateTime                 @default(now())

  preparationTask PreparationTask @relation(fields: [preparationTaskId], references: [id], onDelete: Cascade)
  actorStaffUser  StaffUser?      @relation(fields: [actorStaffUserId], references: [id], onDelete: SetNull)

  @@index([preparationTaskId])
  @@index([type])
  @@index([createdAt])
}

model WaiterCall {
  id              String           @id @default(uuid())
  companyId       String
  branchId        String
  tableSessionId  String
  tableId         String
  orderId         String?
  type            WaiterCallType
  status          WaiterCallStatus @default(open)
  message         String?
  priority        Int              @default(0)
  createdAt       DateTime         @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  cancelledAt     DateTime?
  updatedAt       DateTime         @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession TableSession      @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  table        CafeTable         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  events       WaiterCallEvent[]

  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([tableId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([priority])
}

model WaiterCallEvent {
  id               String               @id @default(uuid())
  waiterCallId     String
  type             WaiterCallEventType
  actorType        WaiterCallActorType
  actorStaffUserId String?
  metadata         Json?
  createdAt        DateTime             @default(now())

  waiterCall     WaiterCall @relation(fields: [waiterCallId], references: [id], onDelete: Cascade)
  actorStaffUser StaffUser? @relation(fields: [actorStaffUserId], references: [id], onDelete: SetNull)

  @@index([waiterCallId])
  @@index([type])
  @@index([actorType])
  @@index([createdAt])
}

model VenueZone {
  id          String        @id @default(uuid())
  companyId   String
  branchId    String
  name        String
  slug        String
  type        VenueZoneType
  description String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  presenceEvents PresenceEvent[]

  @@unique([branchId, slug])
  @@index([companyId])
  @@index([branchId])
  @@index([type])
}

model CustomerSessionIdentity {
  id                 String   @id @default(uuid())
  companyId          String
  branchId           String
  tableSessionId     String?
  displayName        String?
  phone              String?
  locale             String   @default("ar-EG")
  marketingOptIn     Boolean  @default(false)
  notificationsOptIn Boolean  @default(false)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession        TableSession?        @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  deviceSubscriptions DeviceSubscription[]
  notifications       Notification[]
  presenceEvents      PresenceEvent[]

  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([phone])
}

model DeviceSubscription {
  id                        String                   @id @default(uuid())
  companyId                 String
  branchId                  String?
  customerSessionIdentityId String?
  tableSessionId            String?
  channel                   NotificationChannel
  status                    DeviceSubscriptionStatus @default(active)
  endpoint                  String?
  token                     String?
  userAgent                 String?
  metadata                  Json?
  lastSeenAt                DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                  Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerSessionIdentity CustomerSessionIdentity? @relation(fields: [customerSessionIdentityId], references: [id], onDelete: SetNull)
  tableSession            TableSession?            @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  deliveries              NotificationDelivery[]
  presenceEvents          PresenceEvent[]

  @@index([companyId])
  @@index([branchId])
  @@index([customerSessionIdentityId])
  @@index([tableSessionId])
  @@index([channel])
  @@index([status])
}

model PresenceEvent {
  id                        String               @id @default(uuid())
  companyId                 String
  branchId                  String
  tableSessionId            String?
  venueZoneId               String?
  customerSessionIdentityId String?
  deviceSubscriptionId      String?
  triggerType               PresenceTriggerType
  sourceChannel             NotificationChannel?
  metadata                  Json?
  occurredAt                DateTime             @default(now())
  createdAt                 DateTime             @default(now())

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                  Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession            TableSession?            @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  venueZone               VenueZone?               @relation(fields: [venueZoneId], references: [id], onDelete: SetNull)
  customerSessionIdentity CustomerSessionIdentity? @relation(fields: [customerSessionIdentityId], references: [id], onDelete: SetNull)
  deviceSubscription      DeviceSubscription?      @relation(fields: [deviceSubscriptionId], references: [id], onDelete: SetNull)
  notifications           Notification[]

  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([triggerType])
  @@index([occurredAt])
  @@index([venueZoneId])
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  companyId String
  branchId  String?
  key       String
  kind      NotificationKind
  channel   NotificationChannel
  language  String              @default("ar-EG")
  title     String
  body      String
  isActive  Boolean             @default(true)
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([companyId, branchId, key, channel, language], map: "NotificationTemplate_scope_key")
  @@index([companyId])
  @@index([branchId])
  @@index([kind])
  @@index([channel])
  @@index([isActive])
}

model Notification {
  id                        String              @id @default(uuid())
  companyId                 String
  branchId                  String
  tableSessionId            String?
  customerSessionIdentityId String?
  orderId                   String?
  preparationTaskId         String?
  templateId                String?
  presenceEventId           String?
  kind                      NotificationKind
  channel                   NotificationChannel
  status                    NotificationStatus  @default(pending)
  title                     String
  body                      String
  dedupeKey                 String?
  metadata                  Json?
  sentAt                    DateTime?
  readAt                    DateTime?
  dismissedAt               DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                  Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession            TableSession?            @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  customerSessionIdentity CustomerSessionIdentity? @relation(fields: [customerSessionIdentityId], references: [id], onDelete: SetNull)
  order                   Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  preparationTask         PreparationTask?         @relation(fields: [preparationTaskId], references: [id], onDelete: SetNull)
  template                NotificationTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  presenceEvent           PresenceEvent?           @relation(fields: [presenceEventId], references: [id], onDelete: SetNull)
  deliveries              NotificationDelivery[]

  @@unique([dedupeKey])
  @@index([companyId])
  @@index([branchId])
  @@index([tableSessionId])
  @@index([customerSessionIdentityId])
  @@index([kind])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([orderId])
  @@index([preparationTaskId])
}

model NotificationDelivery {
  id                   String                     @id @default(uuid())
  notificationId       String
  deviceSubscriptionId String?
  channel              NotificationChannel
  status               NotificationDeliveryStatus @default(pending)
  externalMessageId    String?
  errorMessage         String?
  sentAt               DateTime?
  failedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  notification       Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceSubscription DeviceSubscription? @relation(fields: [deviceSubscriptionId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([deviceSubscriptionId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}
