  aiWaiterToolCalls         AiWaiterToolCall[]
  aiWaiterUsageEvents       AiWaiterUsageEvent[]
  auditLogs                 AuditLog[]
  company                   Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operatingSettings         BranchOperatingSettings?
  featureFlags              BranchFeatureFlag[]
  bills                     Bill[]
  billRequests              BillRequest[]
  carts                     Cart[]
  floors                    Floor[]
  mediaAssets               MediaAsset[]
  mediaAssetUsages          MediaAssetUsage[]
  menuItemOverrides         BranchMenuItemOverride[]
  notificationTemplates     NotificationTemplate[]
  notifications             Notification[]
  experienceProfiles        ExperienceProfile[]
  contentBlocks             ContentBlock[]
  inventoryLevels           BranchInventoryLevel[]
  inventoryMovements        InventoryMovement[]
  purchaseOrders            PurchaseOrder[]
  inventoryReceipts         InventoryReceipt[]
  orders                    Order[]
  presenceEvents            PresenceEvent[]
  preparationTasks          PreparationTask[]
  kitchenTickets            KitchenTicket[]
  manualPayments            ManualPayment[]
  onlinePaymentIntents      OnlinePaymentIntent[]
  onlinePaymentEvents       OnlinePaymentEvent[]
  onlinePaymentOperations   OnlinePaymentOperation[]
  onlinePaymentReconciliationRuns OnlinePaymentReconciliationRun[]
  onlinePaymentReconciliationEntries OnlinePaymentReconciliationEntry[]
  onlinePaymentReconciliationIssues OnlinePaymentReconciliationIssue[]
  onlinePaymentSettlementBatches OnlinePaymentSettlementBatch[]
  cashierShifts             CashierShift[]
  cashDrawerTransactions    CashDrawerTransaction[]
  cashierShiftReports       CashierShiftReport[]
  printerStations           PrinterStation[]
  printJobs                 PrintJob[]
  billReceipts              BillReceipt[]
  realtimeEvents            RealtimeEvent[]
  smartCashierSettings      BranchSmartCashierSettings?
  smartCashierReviewRules   SmartCashierReviewRule[]
  tableAttentionSnapshots   TableAttentionSnapshot[]
  tableAttentionEvents      TableAttentionEvent[]
  tables                    CafeTable[]
  staffMemberships          StaffMembership[]
  staffInvites              StaffInvite[]
  staffSessions             StaffSession[]
  tableSessions             TableSession[]
  customerSessionIdentities CustomerSessionIdentity[]
  deviceSubscriptions       DeviceSubscription[]
  waiterCalls               WaiterCall[]
  venueZones                VenueZone[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Floor {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables CafeTable[]

  @@index([branchId])
}

model CafeTable {
  id          String      @id @default(uuid())
  branchId    String
  floorId     String?
  code        String
  displayName String
  capacity    Int?
  qrToken     String      @unique
  status      TableStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor         Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  tableSessions TableSession[]
  waiterCalls   WaiterCall[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([floorId])
  @@index([qrToken])
}

model StaffUser {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String
  status        StaffStatus @default(active)
  passwordHash  String?
  passwordSetAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  memberships              StaffMembership[]
  sessions                 StaffSession[]
  staffInvites             StaffInvite[]
  servedOrders             Order[]                 @relation("OrderServedByStaff")
  completedOrders          Order[]                 @relation("OrderCompletedByStaff")
  orderEvents              OrderEvent[]
  acknowledgedBillRequests BillRequest[]           @relation("BillRequestAcknowledgedByStaff")
  presentedBillRequests    BillRequest[]           @relation("BillRequestPresentedByStaff")
  closedBillRequests       BillRequest[]           @relation("BillRequestClosedByStaff")
  cancelledBillRequests    BillRequest[]           @relation("BillRequestCancelledByStaff")
  billRequestEvents        BillRequestEvent[]
  presentedBills           Bill[]                  @relation("BillPresentedByStaff")
  paidBills                Bill[]                  @relation("BillPaidByStaff")
  closedBills              Bill[]                  @relation("BillClosedByStaff")
  cancelledBills           Bill[]                  @relation("BillCancelledByStaff")
  recordedManualPayments   ManualPayment[]         @relation("ManualPaymentRecordedByStaff")
  voidedManualPayments     ManualPayment[]         @relation("ManualPaymentVoidedByStaff")
  openedCashierShifts      CashierShift[]          @relation("CashierShiftOpenedByStaff")
  closedCashierShifts      CashierShift[]          @relation("CashierShiftClosedByStaff")
  cashDrawerTransactions   CashDrawerTransaction[]
  generatedCashierReports  CashierShiftReport[]
  inventoryMovements       InventoryMovement[]
  createdPurchaseOrders     PurchaseOrder[]      @relation("PurchaseOrderCreatedByStaff")
  createdInventoryReceipts  InventoryReceipt[]   @relation("InventoryReceiptCreatedByStaff")
  billEvents               BillEvent[]
  preparationTaskEvents    PreparationTaskEvent[]
  requestedPrintJobs       PrintJob[]              @relation("PrintJobRequestedByStaff")
  onlinePaymentOperations  OnlinePaymentOperation[] @relation("OnlinePaymentOperationRequestedByStaff")
  requestedPaymentReconciliationRuns OnlinePaymentReconciliationRun[] @relation("OnlinePaymentReconciliationRunRequestedByStaff")
  importedPaymentSettlementBatches OnlinePaymentSettlementBatch[] @relation("OnlinePaymentSettlementBatchImportedByStaff")
  acknowledgedPaymentReconciliationIssues OnlinePaymentReconciliationIssue[] @relation("OnlinePaymentReconciliationIssueAcknowledgedByStaff")
  resolvedPaymentReconciliationIssues OnlinePaymentReconciliationIssue[] @relation("OnlinePaymentReconciliationIssueResolvedByStaff")
