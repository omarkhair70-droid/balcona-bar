# Application
# Staging deployments should set NODE_ENV=production for optimized Node behavior
# and APP_ENV=staging for staging-only product policy such as mock payments.
NODE_ENV=development
APP_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=balcona-bar-api
APP_VERSION=0.1.0
# Safe deploy metadata for health/debug responses. Providers may set these automatically.
GIT_SHA=local
BUILD_TIME=

# PostgreSQL / Prisma
# Use a managed or containerized Postgres URL in production. Do not commit real credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=balcona_bar
POSTGRES_USER=balcona
POSTGRES_PASSWORD=balcona_dev_password
DATABASE_URL=postgresql://balcona:balcona_dev_password@localhost:5432/balcona_bar?schema=public

# Redis
# Prefer REDIS_URL in production; host/port fields remain useful for local dev.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Staff auth / customer access
# Current tokens are opaque, database-backed, and stored as hashes. No JWT secret is required in this phase.
STAFF_AUTH_SESSION_HOURS=12
STAFF_INVITE_EXPIRES_DAYS=7
STAFF_AUTH_DEV_BOOTSTRAP_ENABLED=false
CUSTOMER_ACCESS_TOKEN_HOURS=24

# Platform admin auth
# Internal sales/support onboarding surface.
PLATFORM_AUTH_SESSION_HOURS=12
PLATFORM_ADMIN_DEV_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_EMAIL=platform@balcona.local
PLATFORM_ADMIN_NAME=Balcona Platform Admin
PLATFORM_ADMIN_PASSWORD=change-me-platform-123
# For staging bootstrap, set PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true only for
# pnpm deploy:api:bootstrap, use a strong env-provided password, then turn it off.
# Do not use the example password outside local development.

# API docs / browser clients
# Restrict staging/production CORS_ORIGINS to deployed web origins.
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3001

# Background jobs
JOBS_ENABLED=true

# AI waiter provider
# Local/demo defaults to stub. Set AI_WAITER_PROVIDER=groq only on the API runtime.
# Never expose GROQ_API_KEY to the browser or NEXT_PUBLIC_* env.
AI_WAITER_PROVIDER=stub
AI_WAITER_MENU_SNAPSHOT_LIMIT=200
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=10000
GROQ_MAX_RETRIES=1
GROQ_MAX_CONTEXT_ITEMS=8
GROQ_DRY_RUN=false

# Online payments
# This phase supports a backend mock provider only. Do not collect card data in the app.
# Set MOCK_ONLINE_PAYMENTS_ENABLED=false when a real external provider is introduced.
ONLINE_PAYMENTS_ENABLED=true
ONLINE_PAYMENT_PROVIDER=mock
MOCK_ONLINE_PAYMENTS_ENABLED=true
ONLINE_PAYMENT_CHECKOUT_BASE_URL=http://localhost:3001

# Staging smoke bootstrap
# Disabled unless the runtime is non-production, or staging explicitly sets
# SMOKE_BOOTSTRAP_ENABLED=true with APP_ENV=staging. Never enable for APP_ENV=production.
# The token is used only by scripts/smoke/smoke-bootstrap.mjs and must not be printed.
SMOKE_BOOTSTRAP_ENABLED=false
SMOKE_BOOTSTRAP_TOKEN=
SMOKE_RESET_TOKEN=
