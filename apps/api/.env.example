# Application
# Staging deployments should set NODE_ENV=production for optimized Node behavior
# and APP_ENV=staging for staging-only product policy such as mock payments.
NODE_ENV=development
APP_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=balcona-bar-api
APP_VERSION=0.1.0
# Safe deploy metadata for health/debug responses. Providers may set these automatically.
GIT_SHA=local
BUILD_TIME=

# PostgreSQL / Prisma
# Use a managed or containerized Postgres URL in production. Do not commit real credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=balcona_bar
POSTGRES_USER=balcona
POSTGRES_PASSWORD=balcona_dev_password
DATABASE_URL=postgresql://balcona:balcona_dev_password@localhost:5432/balcona_bar?schema=public

# Redis
# Prefer REDIS_URL in production; host/port fields remain useful for local dev.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Staff auth / customer access
# Current tokens are opaque, database-backed, and stored as hashes. No JWT secret is required in this phase.
STAFF_AUTH_SESSION_HOURS=12
STAFF_INVITE_EXPIRES_DAYS=7
STAFF_AUTH_DEV_BOOTSTRAP_ENABLED=false
CUSTOMER_ACCESS_TOKEN_HOURS=24

# Platform admin auth
# Internal sales/support onboarding surface.
PLATFORM_AUTH_SESSION_HOURS=12
PLATFORM_ADMIN_DEV_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_EMAIL=platform@balcona.local
PLATFORM_ADMIN_NAME=Balcona Platform Admin
PLATFORM_ADMIN_PASSWORD=change-me-platform-123
# For staging bootstrap, set PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true only for
# pnpm deploy:api:bootstrap, use a strong env-provided password, then turn it off.
# Do not use the example password outside local development.

# API docs / browser clients
# Restrict staging/production CORS_ORIGINS to deployed web origins.
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3001

# Background jobs
JOBS_ENABLED=true

# AI waiter provider
# Local/demo defaults to stub. Set AI_WAITER_PROVIDER=groq only on the API runtime.
# Never expose GROQ_API_KEY to the browser or NEXT_PUBLIC_* env.
AI_WAITER_PROVIDER=stub
AI_WAITER_MENU_SNAPSHOT_LIMIT=200
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=10000
GROQ_MAX_RETRIES=1
GROQ_MAX_CONTEXT_ITEMS=8
GROQ_DRY_RUN=false

# Online payments
# Local/demo defaults to mock. Set ONLINE_PAYMENT_PROVIDER=paymob only on the API runtime.
# Never collect card data in Balcona and never expose provider keys through NEXT_PUBLIC_*.
ONLINE_PAYMENTS_ENABLED=true
ONLINE_PAYMENT_PROVIDER=mock
MOCK_ONLINE_PAYMENTS_ENABLED=true
ONLINE_PAYMENT_CHECKOUT_BASE_URL=http://localhost:3001

# PAY-8 commercial InstaPay/IPN provider slot (Maestr).
# Server-side placeholders only. Provider-specific create/webhook/inquiry execution
# remains fail-closed until the exact Balcona merchant contract is verified.
MAESTR_API_URL=
MAESTR_API_KEY=
MAESTR_TIMEOUT_MS=10000

# Fawry PAY-7 hosted checkout provider.
# Balcona does not collect PAN/CVV. CARD/MWALLET/PayAtFawry/VALU are handled by Fawry-hosted checkout when enabled for the merchant.
# Confirm the exact live checkout/status URLs with Fawry onboarding before production.
FAWRY_CHECKOUT_URL=https://atfawry.fawrystaging.com/fawrypay-api/api/payments/init
FAWRY_STATUS_URL=https://atfawry.fawrystaging.com/ECommerceWeb/Fawry/payments/status/v2
FAWRY_REFUND_URL=https://atfawry.fawrystaging.com/ECommerceWeb/Fawry/payments/refund
FAWRY_CANCEL_URL=https://atfawry.fawrystaging.com/ECommerceWeb/api/orders/cancel-unpaid-order
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_NOTIFICATION_URL=
FAWRY_RETURN_URL=
FAWRY_ALLOWED_RETURN_ORIGINS=http://localhost:3001
FAWRY_TIMEOUT_MS=10000
FAWRY_CHECKOUT_EXPIRATION_SECONDS=900
FAWRY_EXPECT_LIVE=false

# Paymob PAY-1 provider.
# Leave secrets empty for normal local/CI runs. Test and live credentials/integration IDs must not be mixed.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
# Legacy inquiry/reconciliation credential. Server-side only.
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated Paymob integration IDs enabled for this merchant, e.g. 123456,234567
PAYMOB_INTEGRATION_IDS=
# Public HTTPS backend callback endpoint; PAY-2 will process and HMAC-verify it.
PAYMOB_NOTIFICATION_URL=
# Comma-separated URL origins allowed for customer return URLs, e.g. https://app.example.com
PAYMOB_ALLOWED_RETURN_ORIGINS=http://localhost:3001
PAYMOB_TIMEOUT_MS=10000
PAYMOB_INTENTION_EXPIRATION_SECONDS=900
# false for test credentials/integration IDs; true only with verified live credentials.
PAYMOB_EXPECT_LIVE=false

# Balcona SaaS subscription billing — separate from restaurant/cafe merchant money.
# These credentials belong to Balcona's own billing merchant account.
SAAS_BILLING_ENABLED=false
SAAS_BILLING_PAYMOB_BASE_URL=https://accept.paymob.com
SAAS_BILLING_PAYMOB_API_KEY=
SAAS_BILLING_PAYMOB_SECRET_KEY=
SAAS_BILLING_PAYMOB_PUBLIC_KEY=
SAAS_BILLING_PAYMOB_HMAC_SECRET=
SAAS_BILLING_PAYMOB_3DS_INTEGRATION_ID=
SAAS_BILLING_PAYMOB_MOTO_INTEGRATION_ID=
SAAS_BILLING_PAYMOB_TRANSACTION_WEBHOOK_URL=
SAAS_BILLING_PAYMOB_SUBSCRIPTION_WEBHOOK_URL=
SAAS_BILLING_PAYMOB_RETURN_URL=http://localhost:3001/office/account
SAAS_BILLING_PAYMOB_TIMEOUT_MS=10000
SAAS_BILLING_PAYMOB_INTENTION_EXPIRATION_SECONDS=900
SAAS_BILLING_EXPECT_LIVE=false

# Customer payment route abuse controls.
# Redis-backed in production; production payment requests fail closed if the limiter is unavailable.
ONLINE_PAYMENT_RATE_LIMIT_WINDOW_SECONDS=60
ONLINE_PAYMENT_CREATE_RATE_LIMIT_MAX=6
ONLINE_PAYMENT_READ_RATE_LIMIT_MAX=60
ONLINE_PAYMENT_STAFF_RECOVERY_RATE_LIMIT_MAX=10
ONLINE_PAYMENT_STAFF_OPERATION_RATE_LIMIT_MAX=5

# PAY-6 daily settlement reconciliation.
# Runs idempotently against the previous closed local day.
ONLINE_PAYMENT_SETTLEMENT_RECONCILIATION_ENABLED=false
ONLINE_PAYMENT_SETTLEMENT_RECONCILIATION_INTERVAL_SECONDS=3600
ONLINE_PAYMENT_SETTLEMENT_RECONCILIATION_TIMEZONE=Africa/Cairo
ONLINE_PAYMENT_SETTLEMENT_RECONCILIATION_MAX_ENTRIES=500
ONLINE_PAYMENT_SETTLEMENT_RECONCILIATION_MAX_SCOPES=50

# PAY-4/PAY-7 pull-based recovery. Enable only after the active provider's inquiry credentials are configured.
ONLINE_PAYMENT_RECONCILIATION_ENABLED=false
ONLINE_PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
ONLINE_PAYMENT_RECONCILIATION_STALE_SECONDS=120
ONLINE_PAYMENT_RECONCILIATION_BATCH_SIZE=25

# Staging smoke bootstrap
# Disabled unless the runtime is non-production, or staging explicitly sets
# SMOKE_BOOTSTRAP_ENABLED=true with APP_ENV=staging. Never enable for APP_ENV=production.
# The token is used only by scripts/smoke/smoke-bootstrap.mjs and must not be printed.
SMOKE_BOOTSTRAP_ENABLED=false
SMOKE_BOOTSTRAP_TOKEN=
SMOKE_RESET_TOKEN=
