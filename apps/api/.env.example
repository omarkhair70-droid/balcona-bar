# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=balcona-bar-api
APP_VERSION=0.1.0

# PostgreSQL / Prisma
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=balcona_bar
POSTGRES_USER=balcona
POSTGRES_PASSWORD=balcona_dev_password
DATABASE_URL=postgresql://balcona:balcona_dev_password@localhost:5432/balcona_bar?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
