# Public browser-facing API base URL. In staging/production this must be
# reachable by the user's browser and include the API prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Set to staging in the Vercel staging project. Hosted staging builds reject
# localhost and trycloudflare URLs; use any stable public API host.
NEXT_PUBLIC_APP_ENV=development

# Public/safe build metadata included in debug reports.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_GIT_SHA=local
NEXT_PUBLIC_BUILD_TIME=

# Optional self-serve demo entry. Leave blank until the isolated seeded
# demo tenant exists. Once provisioned, this can be an absolute URL or
# a same-origin path and /demo will expose "Try Balcona Demo".
NEXT_PUBLIC_DEMO_SANDBOX_URL=
