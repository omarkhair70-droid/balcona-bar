# Public browser-facing API base URL. In staging/production this must be
# reachable by the user's browser and include the API prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Set to staging in the Vercel staging project. Staging builds reject localhost
# and trycloudflare API URLs so demos keep using the permanent Railway API.
NEXT_PUBLIC_APP_ENV=development
